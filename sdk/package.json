{
  "name": "@cyphras/private",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "SDK for Cyphras private payments v2: shielded keys and addresses, note encryption, local Groth16 proving and wallet sync for the shielded pool on Stellar",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prover-snarkjs": {
      "types": "./dist/prover-snarkjs/index.d.ts",
      "default": "./dist/prover-snarkjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/unit/**/*.test.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\""
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@scure/base": "1.2.6",
    "@scure/bip39": "1.6.0",
    "@stellar/stellar-base": "15.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "prettier": "3.8.4",
    "typescript": "5.9.3"
  }
}
