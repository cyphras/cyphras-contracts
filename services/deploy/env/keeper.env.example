# Settings of the keeper that are not secret. Secrets are files named by *_FILE variables in
# compose.yaml; nothing here may hold a key, a password or a URL with a key in it.

VAULT=C...
RPC_URL=https://rpc.example.org
LEDGER_META_ARCHIVE_URL=
WINDOW_LEDGERS=500
# Flag reasons the keeper never refunds by itself: 100 is a written order from an authority. The
# depositor can still cancel.
HOLD_REASONS=100
# The keeper account's balance, in stroops, below which it alerts.
BALANCE_FLOOR=500000000
# Exits one release call handles; the vault measured fifteen as fitting every transaction limit.
RELEASE_BATCH=15
# How many exits queued, or released by others, ahead of a claim or release in the ledger it lands
# in still leave it room.
EXIT_KEYS=4
INCLUSION_FEE_CAP=1000000
RESOURCE_FEE_CAP=50000000
# The most resource fee, in stroops, one extension or restoration of entries may pay, apart from
# RESOURCE_FEE_CAP. Extensions pay about a day of rent each, and a step the cap refuses is
# shortened, down to an hour, so a lower cap costs more transactions rather than an entry.
TTL_FEE_CAP=50000000
