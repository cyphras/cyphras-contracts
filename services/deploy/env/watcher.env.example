# Settings of the watcher that are not secret. Secrets are files named by *_FILE variables in
# compose.yaml; nothing here may hold a key, a password or a URL with a key in it.

VAULT=C...
# Two independent RPC providers. For a URL with a key, mount it as a secret file and set
# RPC_URL_FILE or SECOND_RPC_URL_FILE instead.
RPC_URL=https://rpc.example.org
SECOND_RPC_URL=https://rpc.other-provider.example.org
LEDGER_META_ARCHIVE_URL=
WINDOW_LEDGERS=500
# Horizon, for hot-account activity and funding sources; leave empty to skip both.
HORIZON_URL=https://horizon.example.org
# Only for a watcher off the services host, run with watcher.compose.yaml: the indexer and the
# services' health endpoints at their public URLs. On the services host, compose.yaml sets both,
# the keeper's unpublished health included. A health that shows every alert channel of its
# service stalled pages.
INDEXER_URL=https://private.cyphras.com/testnet/xlm/indexer
HEALTH_URLS=https://private.cyphras.com/testnet/xlm/indexer/v1/health,https://private.cyphras.com/testnet/xlm/relayer/v1/health,https://private.cyphras.com/testnet/screening/v1/health
# The dead-man switch the watcher pings after every healthy round is a secret, since its URL holds
# the check's token: the file watcher_heartbeat_url, as HEARTBEAT_URL_FILE names it.
# Accounts checked against CAP-77 freezes besides the vault, its asset, the guardian, the asp and
# the hot accounts, such as the relayer's fee address.
SERVICE_ACCOUNTS=
# Transact calls within 10 minutes above this multiple of the trailing daily rate page, never below
# the floor.
BURST_MULTIPLE=5
BURST_FLOOR=20
# The exit queue pages when it holds this many exits, or its oldest has waited this long.
QUEUE_LENGTH=50
QUEUE_AGE=48h
# Payouts within 7 days that share a funding source with earlier deposits before it pages, and
# sources that fund too many accounts to mean anything, such as exchanges.
ROUND_TRIPS=3
ROUND_TRIP_IGNORE=
# The share of the day's outflow window, in percent, used this soon after midnight UTC that pages
# when one funding source is behind most of it.
EARLY_WINDOW=2h
EARLY_SHARE=80
