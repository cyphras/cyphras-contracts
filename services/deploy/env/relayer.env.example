# Settings of the relayer that are not secret. Secrets are files named by *_FILE variables in
# compose.yaml; nothing here may hold a key, a password or a URL with a key in it.

VAULT=C...
RPC_URL=https://rpc.example.org
# The fee address every relayed proof names as ext.relayer. It only receives; its key stays offline.
FEE_ADDRESS=G...
# The margin over cost, in basis points, published in every quote; at most 1000.
MARGIN_BPS=500
# For a vault of another asset than XLM, how many of the asset's smallest units one stroop is worth,
# as a fraction such as 3/10, from a configured price source; empty for XLM.
ASSET_PER_STROOP=
# The resource fee assumed until 50 relayed transactions have been confirmed, in stroops.
BOOTSTRAP_RESOURCE_FEE=2000000
# Caps on what one transaction may pay, in stroops.
INCLUSION_FEE_CAP=1000000
RESOURCE_FEE_CAP=50000000
