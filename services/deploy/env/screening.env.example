# Settings of the screening service that are not secret. Secrets are files named by *_FILE
# variables in compose.yaml; nothing here may hold a key, a password or a URL with a key in it.

VAULT=C...
RPC_URL=https://rpc.example.org
LEDGER_META_ARCHIVE_URL=
WINDOW_LEDGERS=500
# Horizon, for the funders of depositors and destinations. For a URL with a key, mount it as a
# secret file and set HORIZON_URL_FILE instead.
HORIZON_URL=https://horizon.example.org
MAX_FUNDERS=25
# Funder lookups per minute that relayed unshields may cause; deposit screening is not bounded by
# it, so requests cannot use up the lookups deposits need.
REQUEST_LOOKUPS_PER_MINUTE=30
# The SHA-256, in hex, of the token the relayer presents on the internal endpoint.
SCREEN_TOKEN_SHA256=
# The published exploit and theft addresses, kept by hand in deploy/lists.
EXPLOIT_LIST_FILE=/etc/cyphras/lists/exploits.json
EXPLOIT_LIST_MAX_AGE=720h
# A sanctions list with digital-currency addresses, and the stellar.expert directory.
OFAC_URL=
OFAC_MAX_AGE=48h
DIRECTORY_URL=
DIRECTORY_MAX_AGE=24h
FROZEN_MAX_AGE=15m
POLICY_VERSION=1
INCLUSION_FEE_CAP=1000000
RESOURCE_FEE_CAP=50000000
