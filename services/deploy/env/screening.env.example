# Settings of the screening service that are not secret. Secrets are files named by *_FILE
# variables in compose.yaml; nothing here may hold a key, a password or a URL with a key in it.

VAULT=C...
RPC_URL=https://rpc.example.org
LEDGER_META_ARCHIVE_URL=
WINDOW_LEDGERS=500
# Horizon, for the funders of depositors and destinations. For a URL with a key, mount it as a
# secret file and set HORIZON_URL_FILE instead.
HORIZON_URL=https://horizon.example.org
# How many funders that matter are checked for each address, and how many pages of its history
# that hold value for it Horizon is read for; pages of its own activity are read on up to twice
# that. More of either than this leaves the check incomplete, which refers a deposit to a person,
# who decides it while it is held with reason 6, and withholds an unshield; the decision record
# says so.
MAX_FUNDERS=25
FUNDER_MAX_PAGES=50
# A funder does not matter when, for every asset it sent, it is below both this share of what the
# address received of that asset, in basis points, and the asset's floor in its smallest unit, as
# asset=amount pairs with the asset as native or CODE:ISSUER. An asset without a floor always
# matters. The defaults are 1 percent and 10 XLM.
FUNDER_DUST_SHARE_BPS=100
FUNDER_DUST_FLOORS=native=100000000
# Accounts whose funders are not read, such as an exchange's deposit account, whose inflows are too
# many to read; each is still checked against every list.
FUNDER_EXEMPT=
# Funder lookups per minute that relayed unshields may cause; deposit screening is not bounded by
# it, so requests cannot use up the lookups deposits need.
REQUEST_LOOKUPS_PER_MINUTE=30
# Deposit checks: how many run at once, and how many and for how long one round runs at most.
# Deadline work runs first in every round.
SCREEN_WORKERS=4
SCREEN_TICK_CHECKS=40
SCREEN_TICK_BUDGET=15s
# The SHA-256, in hex, of the token the relayer presents on the internal endpoint.
SCREEN_TOKEN_SHA256=
# An update of a list that shrinks it by more than this percentage, or that misses one of the
# list's canaries, entries that must stay on it separated by "|", is refused: the previous list
# stays in use and an alert is raised. The size and canaries of the last good copy are kept in the
# database, so the first update after a restart is checked too; a list without canaries set here
# is checked for those its last good copy held.
SOURCE_MAX_SHRINK_PCT=20
# The published exploit and theft addresses, kept by hand in deploy/lists. Set its canaries to
# addresses that stay on the list; there are no defaults.
EXPLOIT_LIST_FILE=/etc/cyphras/lists/exploits.json
EXPLOIT_LIST_MAX_AGE=720h
EXPLOIT_LIST_CANARIES=
# The SDN list with digital-currency addresses. Its size is the number of Stellar addresses it
# holds, and its canaries are text anywhere in it; unset, they are the defaults below.
OFAC_URL=
OFAC_MAX_AGE=48h
OFAC_CANARIES=Digital Currency Address - XBT|Digital Currency Address - ETH|LAZARUS GROUP
# The stellar.expert directory. Set its canaries to long-tagged malicious addresses; there are no
# defaults.
DIRECTORY_URL=
DIRECTORY_MAX_AGE=24h
DIRECTORY_CANARIES=
FROZEN_MAX_AGE=15m
POLICY_VERSION=1
INCLUSION_FEE_CAP=1000000
RESOURCE_FEE_CAP=50000000
