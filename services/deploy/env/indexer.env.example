# Settings of the indexer that are not secret. Secrets are files named by *_FILE variables in
# compose.yaml; nothing here may hold a key, a password or a URL with a key in it.

# The vault this indexer serves, as listed in deployments/<network>.json.
VAULT=C...
# A Stellar RPC without a key in its URL. For a URL with a key, mount it as a secret file and set
# RPC_URL_FILE instead.
RPC_URL=https://rpc.example.org
# The SEP-54 ledger archive used to rebuild once RPC has dropped the vault's early ledgers. Mainnet
# has a public one; leave empty on testnet, where the indexer's own event archive is the source.
LEDGER_META_ARCHIVE_URL=https://aws-public-blockchain.s3.us-east-2.amazonaws.com/v1.1/stellar/ledgers/pubnet
# Ledgers applied at once while catching up.
WINDOW_LEDGERS=500
POLL=1s
